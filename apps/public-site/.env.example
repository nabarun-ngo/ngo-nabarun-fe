# ---------------------------------------------------------------------------
# Site (public)
# ---------------------------------------------------------------------------
# Production (used by default with `npm run build`)
# Must match the domain the site is actually served from, otherwise canonical
# URLs, sitemap, and og:url point at a domain Google cannot verify.
NEXT_PUBLIC_SITE_URL=https://nabarunngo.web.app

# Staging — set these when building for nabarunngo-stage.web.app
# NEXT_PUBLIC_SITE_URL=https://nabarunngo-stage.web.app
# NEXT_PUBLIC_NOINDEX=true

# Optional SEO / analytics (public)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# WebP + square icons are generated in prebuild/predev via `npm run generate:assets`
# (scripts/generate-assets.mjs). Clear with `npm run clean:generated`.
# Font Awesome, Bootstrap Icons, and Bootstrap JS are bundled via npm imports in layout/Carousel.

# ---------------------------------------------------------------------------
# Page & nav configuration (content2.json)
# ---------------------------------------------------------------------------
# Routes, nav links, and page enablement are driven by public/content2.json:
# - layout.navbar.navLinks[] — navbar (enabled, inMore, endCta, parent, id, url)
# - metadata.pages.*.enabled — page 404 gate + sitemap inclusion
# - metadata.pages.*.path — canonical page URL
# - metadata.pages.*.noindex — set true to exclude a page from sitemap and add noindex (e.g. expired form campaigns)
#
# Nav link URL overrides (optional; server-only, NAV_ prefix + uppercase id):
# NAV_LOGIN=https://nabarunngo-portal.web.app

# ---------------------------------------------------------------------------
# Data layer
# ---------------------------------------------------------------------------
# Mock both API surfaces (default true). Set to false to use the real backend.
NEXT_PUBLIC_USE_MOCK_API=true

# API — shared base URL for build-time GET (API-key protected) and browser POST
# (reCAPTCHA protected). API_KEY must NOT use NEXT_PUBLIC_ (server-only).
# Endpoints (relative to NEXT_PUBLIC_API_BASE_URL):
#   GET /api/public-site/contents/static
#   GET /api/public-site/contents/dynamic
#   GET /api/public-site/contents/{formId}/form-defination  → FormDefinition (see src/data/mock/form-definitions.json)
#   POST /api/public-site/forms/submit-contact-request   (reCAPTCHA: submit_contact)
#   POST /api/public-site/forms/submit-join-request      (reCAPTCHA: submit_join)
#   POST /api/public-site/forms/submit-dynamic-form/{formId}  (reCAPTCHA: action from content)
#   POST /newsletter                                     (reCAPTCHA: newsletter)
# Mock fixtures (when NEXT_PUBLIC_USE_MOCK_API=true):
#   src/data/mock/content-static.json, src/data/mock/contents-dynamic.json,
#   src/data/mock/form-definitions.json
NEXT_PUBLIC_API_BASE_URL=
API_KEY=
NEXT_PUBLIC_SITE_KEY=

# Online donation checkout URL (used when pages.donate.gatewayCta is enabled)
# NEXT_PUBLIC_PAYMENT_GATEWAY_URL=https://your-payment-provider.com/checkout
