{
  "contact": {
    "id": "form-contact",
    "key": "contact",
    "label": "Send us a message",
    "description": null,
    "fields": [
      {
        "id": "contact-field-name",
        "key": "fullName",
        "label": "Your Name",
        "fieldType": "TEXT",
        "mandatory": true,
        "fieldOptions": [],
        "isHidden": false,
        "isEncrypted": false,
        "enabled": true,
        "sortOrder": 1,
        "condition": null,
        "dependentOptions": null,
        "validationRules": [
          {
            "key": "format",
            "pattern": "^[A-Za-z][A-Za-z\\s'.-]{1,79}$",
            "regexErrMsg": "Enter a valid name (letters only, 2–80 characters)"
          },
          {
            "key": "no-digits",
            "pattern": "^[^0-9]*$",
            "regexErrMsg": "Cannot contain numbers"
          }
        ]
      },
      {
        "id": "contact-field-email",
        "key": "email",
        "label": "Your Email",
        "fieldType": "EMAIL",
        "mandatory": true,
        "fieldOptions": [],
        "isHidden": false,
        "isEncrypted": false,
        "enabled": true,
        "sortOrder": 2,
        "condition": null,
        "dependentOptions": null,
        "validationRules": [
          {
            "key": "format",
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "regexErrMsg": "Enter a valid email address"
          }
        ]
      },
      {
        "id": "contact-field-phone",
        "key": "fullPhoneNumber",
        "label": "Phone",
        "fieldType": "PHONE",
        "mandatory": true,
        "fieldOptions": [],
        "isHidden": false,
        "isEncrypted": false,
        "enabled": true,
        "sortOrder": 3,
        "condition": null,
        "dependentOptions": null,
        "validationRules": [
          {
            "key": "format",
            "pattern": "^\\+[0-9]{10,15}$",
            "regexErrMsg": "Enter a valid phone number with country code"
          }
        ]
      },
      {
        "id": "contact-field-subject",
        "key": "subject",
        "label": "Subject",
        "fieldType": "TEXT",
        "mandatory": true,
        "fieldOptions": [],
        "isHidden": false,
        "isEncrypted": false,
        "enabled": true,
        "sortOrder": 4,
        "condition": null,
        "dependentOptions": null,
        "validationRules": []
      },
      {
        "id": "contact-field-message",
        "key": "message",
        "label": "Message",
        "fieldType": "TEXTAREA",
        "mandatory": true,
        "fieldOptions": [],
        "isHidden": false,
        "isEncrypted": false,
        "enabled": true,
        "sortOrder": 8,
        "condition": null,
        "dependentOptions": null,
        "validationRules": [
          {
            "key": "format",
            "pattern": "^[\\s\\S]{20,2000}$",
            "regexErrMsg": "Please write at least 20 characters"
          },
          {
            "key": "no-html",
            "pattern": "^[^<>]*$",
            "regexErrMsg": "Cannot contain < or > characters"
          }
        ]
      }
    ]
  },
