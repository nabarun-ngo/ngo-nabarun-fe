        "dependentOptions": null,
        "validationRules": [
          {
            "key": "format",
            "pattern": "^[A-Za-z][A-Za-z\\s'.-]{1,79}$",
            "regexErrMsg": "Enter a valid name (letters only, 2–80 characters)"
