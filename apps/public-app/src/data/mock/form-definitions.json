        "dependentOptions": null,
        "validationRules": null
      },
      {
        "id": "contact-field-message",
        "key": "message",
        "label": "Message",
        "fieldType": "TEXTAREA",
        "mandatory": true,
        "fieldOptions": [],
        "isHidden": false,
        "isEncrypted": false,
        "enabled": true,
        "sortOrder": 8,
        "condition": {
          "dependsOnKey": "inquiryTopic",
          "operator": "not_equals",
          "value": ""
        },
        "dependentOptions": null,
        "validationRules": [
          {
            "key": "format",
            "pattern": "^[\\s\\S]{20,2000}$",
            "regexErrMsg": "Please write at least 20 characters"
          },
          {
            "key": "no-html",
            "pattern": "^[^<>]*$",
            "regexErrMsg": "Cannot contain < or > characters"
          }
        ]
      }
