# ---------------------------------------------------------------------------
# Internal app environment
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored.
#
# These values are read by scripts/generate-env.mjs, which runs automatically
# before dev, build and test, and writes src/environments/env.generated.ts.
# src/environments/environment.ts then shapes them into the `environment`
# object the app consumes.
#
# Any variable named NG_APP_* is picked up automatically, so adding one here and
# reading it in environment.ts is all that is needed. Variables without that
# prefix are ignored on purpose, because the generator reads the whole process
# environment and only prefixed values are safe to ship to the browser.
#
# This file is the only place defaults live; there are none in TypeScript. Every
# key below has to be present in some source or the build fails to compile, and
# the error names the missing key. A key may be blank, which is how the Auth0
# values stay unset for local work, but it cannot be absent altogether.
#
# Precedence, highest first:
#   1. real environment variables  (how CI supplies deploy values)
#   2. .env                        (local development only)
#
# .env is optional, and is loaded by Node's --env-file-if-exists flag in the npm
# scripts rather than by the generator itself. CI ships no .env and supplies the
# values as real environment variables instead, which is the intended path rather
# than a fallback. A real environment variable always wins, because Node will not
# let the file overwrite one that is already set.
#
# EVERY value below is inlined into the browser bundle and readable in
# devtools. These are public identifiers, not secrets. Never put an API key,
# client secret or signing key in this file.

# ---------------------------------------------------------------------------
# Build identity
# ---------------------------------------------------------------------------
NG_APP_NODE_ENV=local

# Enables Angular's production mode. Set true for stage and production.
NG_APP_PRODUCTION=false

# Registers the ngsw + OneSignal combined service worker. Keep false locally,
# otherwise the worker caches your dev bundles and serves them stale.
NG_APP_REGISTER_SERVICE_WORKER=false

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# Root URL for the generated API client and Auth0 interceptor uriMatcher.
NG_APP_API_BASE_URL=http://localhost:8082

# ---------------------------------------------------------------------------
# Local dev mode
# ---------------------------------------------------------------------------
# Skip Auth0 login and use demo RBAC/identity for UI work without a backend.
# Does not select mock feature data — use NG_APP_MOCK_DATA for that.
# Never set true in stage or production.
# Legacy alias NG_APP_ENABLE_AUTH_BYPASS is also supported.
NG_APP_BYPASS_AUTH=false

# Bind demo/mock feature data sources (donations, dashboard metrics, etc.)
# instead of calling the backend API. Independent of NG_APP_BYPASS_AUTH.
# Never set true in stage or production.
NG_APP_MOCK_DATA=false

# ---------------------------------------------------------------------------
# Auth0
# ---------------------------------------------------------------------------
# Left blank on purpose so a fresh clone cannot accidentally authenticate
# against a real tenant. Nothing checks that these are filled in, so a deployed
# build with them blank will compile and then fail at login; stage and production
# have to supply them as real environment variables.
#
# Auth0 establishes identity only. Permissions and roles come from the backend's
# own RBAC tables, so there are no per-feature scopes to configure here.
NG_APP_AUTH0_DOMAIN=
NG_APP_AUTH0_CLIENT_ID=
NG_APP_AUTH0_AUDIENCE=

# ---------------------------------------------------------------------------
# Web push
# ---------------------------------------------------------------------------
# OneSignal app ID. The all-zero UUID is an intentional no-op placeholder that
# keeps the SDK from registering against a real project during local work.
NG_APP_ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Session timeouts (seconds)
# ---------------------------------------------------------------------------
# Idle window before the inactivity warning appears. Deliberately short in dev
# so the timeout path is easy to exercise; raise it for deployed builds.
NG_APP_MAX_IDLE_TIME_IN_SEC=10

# Hard session cap handed to the idle timer. 7200 = 2 hours.
NG_APP_INACTIVITY_TIMEOUT_SEC=7200
