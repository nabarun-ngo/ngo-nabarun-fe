{
  "name": "@nabarun-ngo/internal-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "npm run generate:env && npm run generate:assets",
    "generate:env": "node --env-file-if-exists=.env scripts/generate-env.mjs",
    "generate:assets": "node scripts/generate-assets.mjs",
    "clean": "rimraf dist .angular .turbo && node scripts/clean-generated.mjs",
    "start:dev": "npm run setup && ng serve --port 4200",
    "build": "npm run clean && npm run setup && ng build",
    "build:beta": "ng build --configuration beta",
    "lint": "npm run generate:env && tsc --noEmit -p tsconfig.app.json",
    "test": "npm run generate:env && ng test --watch=false --browsers=ChromeHeadless",
    "generate:api": "rimraf src/app/core/api/api-client && ng-openapi-gen --input src/app/core/api/swagger.json --output src/app/core/api/api-client"
  },
  "dependencies": {
    "@angular/animations": "^21.2.19",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@angular/service-worker": "^21.2.19",
    "@auth0/auth0-angular": "^2.11.0",
    "@ssdev-toolkit/angular-auth": "1.0.0",
    "@ssdev-toolkit/auth-core": "1.0.0",
    "@ssdev-toolkit/angular-comment": "1.0.0",
    "@ssdev-toolkit/comment-core": "1.0.0",
    "@ssdev-toolkit/angular-forms": "1.0.0",
    "@ssdev-toolkit/forms-core": "1.0.0",
    "@ssdev-toolkit/angular-list-dashboard": "1.0.0",
    "@ssdev-toolkit/list-dashboard-core": "1.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "libphonenumber-js": "^1.13.10",
    "onesignal-ngx": "^2.4.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-openapi-gen": "^0.52.0",
    "postcss": "^8.4.38",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.3",
    "typescript": "~5.9.3"
  }
}