{
  "name": "ngo-nabarun-fe",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean:generated": "node scripts/clean-generated.mjs --keep-node-modules",
    "clean:reset": "node scripts/clean-generated.mjs",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "watch:packages": "turbo watch build --filter=./packages/*",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && npm install",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "start": "start npm run watch:packages && start npm run dev --workspace=apps/public-site && npm run dev --workspace=apps/internal-app"
  },
  "devDependencies": {
    "@angular/cli": "^21.2.19",
    "@changesets/cli": "^2.31.1",
    "@types/jest": "^30.0.0",
    "rimraf": "^6.1.3",
    "turbo": "^2.5.4"
  },
  "overrides": {
    "rxjs": "7.8.2"
  }
}