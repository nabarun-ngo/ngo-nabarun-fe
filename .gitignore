# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (public-site)
apps/public-site/.next/
apps/public-site/out/

# angular (internal-app)
apps/internal-app/dist/
apps/internal-app/.angular/

# legacy root paths (if any)
/.next/
/out/
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.firebase
.qodo
.idea

# turbo
.turbo

apps/public-site/public/robots.txt
apps/public-site/public/sitemap.xml
apps/public-site/public/sitemap-0.xml

apps/public-site/out/robots.txt
apps/public-site/out/sitemap.xml
apps/public-site/out/sitemap-0.xml

# Generated public-site assets: see apps/public-site/.gitignore

**/node_modules/**
**/dist/**
**/.next/**
**/out/**
**/.angular/**

# Cursor hook runtime (workspace hooks live at integrated/.cursor/hooks; never commit state)
.cursor/hooks/
